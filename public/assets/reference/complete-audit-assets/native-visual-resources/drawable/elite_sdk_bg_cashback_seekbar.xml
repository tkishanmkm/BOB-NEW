<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:height="@dimen/elite_sdk_spacing_8dp" android:top="@dimen/elite_sdk_spacing_6dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/elite_sdk_spacing_8dp" />
            <solid android:color="@color/elite_sdk_gray_medium" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:height="@dimen/elite_sdk_spacing_8dp" android:top="@dimen/elite_sdk_spacing_6dp">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/elite_sdk_spacing_8dp" />
                <solid android:color="@color/seekbar_progress_color" />
            </shape>
        </clip>
    </item>
</layer-list>
