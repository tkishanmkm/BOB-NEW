<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/secondaryProgress">
        <shape android:shape="ring" android:useLevel="true" android:innerRadius="20.0dp" android:thickness="5.0dp">
            <gradient android:startColor="@color/black" android:endColor="@color/black" android:angle="0.0" android:type="sweep" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:fromDegrees="270.0" android:toDegrees="270.0" android:pivotX="50.0%" android:pivotY="50.0%">
            <shape android:shape="ring" android:useLevel="true" android:innerRadius="20.0dp" android:thickness="5.0dp">
                <gradient android:startColor="?colorPrimary" android:endColor="?colorPrimary" android:useLevel="false" android:angle="0.0" android:type="sweep" />
            </shape>
        </rotate>
    </item>
</layer-list>
